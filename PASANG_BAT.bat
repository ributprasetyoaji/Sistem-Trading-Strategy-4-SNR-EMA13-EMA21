:cari_tk
set "TK="
if exist "%~dp0TOKEN.txt" set /p TK=<"%~dp0TOKEN.txt"
if not defined TK if exist "C:\RBT\TOKEN.txt" set /p TK=<"C:\RBT\TOKEN.txt"
if not defined TK if exist "%APPDATA%\RBT_FX\gh_token.txt" set /p TK=<"%APPDATA%\RBT_FX\gh_token.txt"
if not defined TK for /d %%D in ("C:\RBT\*") do if exist "%%D\TOKEN.txt" if not defined TK set /p TK=<"%%D\TOKEN.txt"
if defined TK set "TK=%TK: =%"
if defined TK if "%TK:~30,1%"=="" set "TK="
exit /b 0

:simpan_tk
>"%~dp0TOKEN.txt" echo %TK%
if not exist "%APPDATA%\RBT_FX" mkdir "%APPDATA%\RBT_FX" >nul 2>nul
>"%APPDATA%\RBT_FX\gh_token.txt" echo %TK%
echo [OK] Token GitHub disimpan di 2 tempat - TIDAK AKAN DITANYA LAGI.
exit /b 0
